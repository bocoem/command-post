{
 "questions": [
  {
   "name": "name",
   "type": "esriQuestionTypeText",
   "label": "Name",
   "fieldName": "name",
   "fieldLength": 255,
   "fieldType": "esriFieldTypeString",
   "required": {
    "type": "xlsform",
    "expression": "true()"
   }
  },
  {
   "name": "phone_contact",
   "type": "esriQuestionTypeText",
   "label": "Phone number",
   "fieldName": "phone_contact",
   "fieldLength": 255,
   "fieldType": "esriFieldTypeString",
   "isCachedAnswer": true,
   "required": {
    "type": "xlsform",
    "expression": "true()"
   },
   "visibility": {
    "type": "xlsform",
    "expression": "true()"
   }
  },
  {
   "name": "type",
   "type": "esriQuestionTypeSingleChoice",
   "label": "Type",
   "fieldName": "type",
   "fieldType": "esriFieldTypeString",
   "required": {
    "type": "xlsform",
    "expression": "true()"
   },
   "visibility": {
    "type": "xlsform",
    "expression": "true()"
   },
   "choices": {
    "items": [
     {
      "value": "impassable_road",
      "label": "Impassable road [EM, VDOT, NWS]"
     },
     {
      "value": "Water in Road",
      "label": "Water in road [EM, VDOT, NWS]"
     },
     {
      "value": "risk_to_traffic",
      "label": "Risk to traffic [EM, VDOT]"
     },
     {
      "value": "roadway_infrastructure_damage",
      "label": "Roadway infrastructure damage [EM, VDOT]"
     },
     {
      "value": "Snow Report",
      "label": "Snow report [EM, NWS]"
     },
     {
      "value": "Situation Update",
      "label": "Situation update [EM, NWS]"
     },
     {
      "value": "tree_down_not_in_road",
      "label": "Tree down, not in road [EM, NWS]"
     },
     {
      "value": "structural_damage",
      "label": "Structural damage [EM, NWS]"
     },
     {
      "value": "Property Damage",
      "label": "Property damage [EM]"
     },
     {
      "value": "power_lines_down",
      "label": "Power lines down [EM, NWS, power company]"
     },
     {
      "value": "emergency_access",
      "label": "Emergency response access emergency [EM, VDOT]"
     }
    ],
    "other": {
     "isEnabled": true,
     "isShorthand": false,
     "value": "other",
     "name": "type_other",
     "fieldName": "type_other",
     "label": "Other [EM]"
    }
   }
  },
  {
   "name": "pl_utility",
   "type": "esriQuestionTypeSingleChoice",
   "label": "Power company",
   "fieldName": "pl_utility",
   "fieldType": "esriFieldTypeString",
   "required": {
    "type": "xlsform",
    "expression": "false()"
   },
   "visibility": {
    "type": "xlsform",
    "expression": "${type} = 'power_lines_down'"
   },
   "choices": {
    "items": [
     {
      "value": "aep",
      "label": "AEP (Appalachian Power)"
     },
     {
      "value": "dominion",
      "label": "Dominion Energy"
     },
     {
      "value": "cbec",
      "label": "Craig-Botetourt Electric"
     }
    ],
    "other": {
     "isEnabled": false,
     "isShorthand": false,
     "value": "other",
     "name": "pl_utility_other",
     "fieldName": "pl_utility_other",
     "label": "Other"
    }
   }
  },
  {
   "name": "pl_pole",
   "type": "esriQuestionTypeText",
   "label": "Pole number",
   "fieldName": "pl_pole",
   "fieldLength": 255,
   "fieldType": "esriFieldTypeString",
   "required": {
    "type": "xlsform",
    "expression": "false()"
   },
   "visibility": {
    "type": "xlsform",
    "expression": "${type} = 'power_lines_down'"
   }
  },
  {
   "name": "photo",
   "type": "esriQuestionTypeImage",
   "label": "Photo",
   "fieldType": "esriAttachment",
   "required": {
    "type": "xlsform",
    "expression": "true()"
   },
   "visibility": {
    "type": "xlsform",
    "expression": "true()"
   },
   "validation": {
    "allowFileType": {
     "type": "image",
     "exts": [
      "*"
     ]
    },
    "allowFileSize": {
     "min": 0,
     "max": 10
    },
    "constraint": {
     "type": "xlsform",
     "expression": "count-selected(${photo})<=3",
     "message": "You must select at most 3 files."
    }
   }
  },
  {
   "name": "comments",
   "type": "esriQuestionTypeTextArea",
   "label": "Comments",
   "fieldName": "comments",
   "fieldType": "esriFieldTypeString",
   "required": {
    "type": "xlsform",
    "expression": "false()"
   },
   "visibility": {
    "type": "xlsform",
    "expression": "true()"
   }
  },
  {
   "name": "location",
   "type": "esriQuestionTypeGeoPoint",
   "label": "Exact location of Report",
   "fieldType": "esriFieldTypeGeometry",
   "required": {
    "type": "xlsform",
    "expression": "true()"
   },
   "visibility": {
    "type": "xlsform",
    "expression": "true()"
   }
  }
 ]
}