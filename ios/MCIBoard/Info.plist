<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only standard HTTPS: no export-compliance paperwork. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- BCEM brand fonts (Google Fonts, SIL Open Font License), the same files as the other county apps. -->
	<key>UIAppFonts</key>
	<array>
		<string>BarlowCondensed-ExtraBold.ttf</string>
		<string>BarlowCondensed-SemiBold.ttf</string>
	</array>
	<!-- beaconmci://open?incident=KEY opens that incident (the Command Board app's MCI panel links here). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.dmurray.MCIBoard</string>
			<key>CFBundleURLSchemes</key>
			<array><string>beaconmci</string></array>
		</dict>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
</dict>
</plist>
